# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Deliberate Failure Switch (Set to true or 1 to trigger deliberate ingestion failure)
FAIL_INGESTION=false

# Batch Pipeline Default Parameters
DEFAULT_BATCH_DATE=2026-10-13
BATCH_ORDER_COUNT=1200
BATCH_TELEMETRY_COUNT=2500
DIRTY_RECORD_RATE=0.05

# PostgreSQL 16 (Staging & Airflow Metadata)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fastroute_user
POSTGRES_PASSWORD=fastroute_password
POSTGRES_DB=fastroute_db

# MinIO S3 Object Storage (Raw Lake)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_RAW_BUCKET=fastroute-raw
MINIO_STAGING_BUCKET=fastroute-staging

# ClickHouse 24 (Analytical OLAP Engine)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=fastroute_analytics

# Apache Airflow 2.8 (DAG Orchestrator)
AIRFLOW_HOST=airflow-webserver
AIRFLOW_WWW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=46GadBkiBicSIip2Yzc7U-zW465_VGGBfV6_r9bE1_4=
