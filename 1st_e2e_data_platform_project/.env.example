# FastRoute Logistics Environment Configuration Template

# PostgreSQL Staging & Airflow Metadata DB
POSTGRES_USER=fastroute_user
POSTGRES_PASSWORD=fastroute_password
POSTGRES_DB=fastroute_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MinIO Object Storage (S3 API)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=fastroute-raw
MINIO_STAGING_BUCKET=fastroute-staging

# ClickHouse OLAP Analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=fastroute_analytics
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Apache Airflow Configuration
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@fastroute.com
AIRFLOW_FERNET_KEY=46GadBkiBicSIip2Yzc7U-zW465_VGGBfV6_r9bE1_4=
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_WWW_PORT=8080

# Application & UI Configuration
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
LOG_LEVEL=INFO
